<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ios_bg_black"
    android:fitsSystemWindows="true">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_circle_btn"
            android:src="@drawable/ic_back"
            app:tint="@color/ios_text_primary"
            android:contentDescription="Indietro" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/create_qr_title"
            android:textColor="@color/ios_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="44dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Type Selector Horizontal Scroll -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIPO DI CONTENUTO"
                android:textColor="@color/ios_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupTypes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipUrl"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type_url"
                        android:textColor="@color/ios_text_primary"
                        app:chipBackgroundColor="@color/ios_card_elevated"
                        app:chipStrokeColor="@color/ios_separator"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipText"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type_text"
                        android:textColor="@color/ios_text_primary"
                        app:chipBackgroundColor="@color/ios_card_elevated"
                        app:chipStrokeColor="@color/ios_separator" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWifi"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type_wifi"
                        android:textColor="@color/ios_text_primary"
                        app:chipBackgroundColor="@color/ios_card_elevated"
                        app:chipStrokeColor="@color/ios_separator" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipContact"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type_contact"
                        android:textColor="@color/ios_text_primary"
                        app:chipBackgroundColor="@color/ios_card_elevated"
                        app:chipStrokeColor="@color/ios_separator" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPhone"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type_phone"
                        android:textColor="@color/ios_text_primary"
                        app:chipBackgroundColor="@color/ios_card_elevated"
                        app:chipStrokeColor="@color/ios_separator" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEmail"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type_email"
                        android:textColor="@color/ios_text_primary"
                        app:chipBackgroundColor="@color/ios_card_elevated"
                        app:chipStrokeColor="@color/ios_separator" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSms"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type_sms"
                        android:textColor="@color/ios_text_primary"
                        app:chipBackgroundColor="@color/ios_card_elevated"
                        app:chipStrokeColor="@color/ios_separator" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Dynamic Input Container -->
            <LinearLayout
                android:id="@+id/layoutInputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <!-- Single Primary Input (URL / Text / Phone / etc.) -->
                <EditText
                    android:id="@+id/etInput1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/input_url_hint"
                    android:textColor="@color/ios_text_primary"
                    android:textColorHint="@color/ios_text_tertiary"
                    android:textSize="15sp"
                    android:inputType="textUri"
                    android:layout_marginBottom="12dp" />

                <!-- Secondary Input (Password for WiFi / Email Subject / Contact Phone) -->
                <EditText
                    android:id="@+id/etInput2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:hint="Secondo parametro"
                    android:textColor="@color/ios_text_primary"
                    android:textColorHint="@color/ios_text_tertiary"
                    android:textSize="15sp"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <!-- Tertiary Input (Contact Email / SMS body) -->
                <EditText
                    android:id="@+id/etInput3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:hint="Terzo parametro"
                    android:textColor="@color/ios_text_primary"
                    android:textColorHint="@color/ios_text_tertiary"
                    android:textSize="15sp"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />
            </LinearLayout>

            <!-- QR Preview Card (Apple Clean Container) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <ImageView
                        android:id="@+id/ivQrPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp"
                        android:scaleType="fitCenter" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Universal Share Button (Main action) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareQr"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/btn_share_qr"
                android:textColor="@color/ios_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/ios_text_primary"
                app:backgroundTint="@color/apple_blue"
                android:layout_marginBottom="12dp" />

            <!-- Secondary Actions Row (Save Gallery & Copy) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveGallery"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="@string/btn_save_gallery"
                    android:textColor="@color/ios_text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_gallery"
                    app:iconTint="@color/ios_text_primary"
                    app:backgroundTint="@color/ios_card_elevated"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyText"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="@string/btn_copy_content"
                    android:textColor="@color/ios_text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_copy"
                    app:iconTint="@color/ios_text_primary"
                    app:backgroundTint="@color/ios_card_elevated"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
