<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg_black"
    tools:context=".MainActivity">

    <!-- Main Scanner Screen Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Live Camera Viewfinder -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <!-- Apple Style Laser & Reticle Overlay -->
        <com.apple.quickscan.scanner.ViewfinderView
            android:id="@+id/viewfinderView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top Navigation Glass Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="48dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Drawer Hamburger Button -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_circle_btn"
                android:src="@drawable/ic_menu"
                app:tint="@color/ios_text_primary"
                android:contentDescription="Menu" />

            <!-- Title Pill -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="QuickScan"
                android:textColor="@color/ios_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Torch Toggle Button -->
            <ImageButton
                android:id="@+id/btnTorch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_circle_btn"
                android:src="@drawable/ic_flash_off"
                app:tint="@color/ios_text_primary"
                android:layout_marginEnd="10dp"
                android:contentDescription="Torcia" />

            <!-- Gallery Import Button -->
            <ImageButton
                android:id="@+id/btnGallery"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_circle_btn"
                android:src="@drawable/ic_gallery"
                app:tint="@color/ios_text_primary"
                android:contentDescription="Galleria" />
        </LinearLayout>

        <!-- Dynamic Island / Floating Notification Pill -->
        <LinearLayout
            android:id="@+id/layoutDynamicIsland"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="105dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_glass_pill"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:elevation="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/apple_green"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvIslandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/copied_to_clipboard"
                    android:textColor="@color/ios_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvIslandSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Codice memorizzato"
                    android:textColor="@color/ios_text_secondary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Guidance Pill -->
        <TextView
            android:id="@+id/tvBottomHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_glass_pill"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="@string/scan_hint"
            android:textColor="@color/ios_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Camera Permission Request Layout (if denied) -->
        <LinearLayout
            android:id="@+id/layoutPermissionRequired"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ios_bg_black"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_barcode"
                app:tint="@color/apple_blue"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Permesso Fotocamera"
                android:textColor="@color/ios_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/camera_permission_required"
                android:textColor="@color/ios_text_secondary"
                android:textSize="15sp"
                android:layout_marginBottom="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrantPermission"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="@string/grant_permission"
                android:textColor="@color/ios_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/apple_blue"
                android:paddingStart="32dp"
                android:paddingEnd="32dp" />
        </LinearLayout>

    </FrameLayout>

    <!-- Side Navigation Drawer -->
    <include
        android:id="@+id/drawerMenu"
        layout="@layout/drawer_content" />

</androidx.drawerlayout.widget.DrawerLayout>
