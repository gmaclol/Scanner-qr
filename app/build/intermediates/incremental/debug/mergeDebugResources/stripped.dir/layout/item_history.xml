<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_apple_secondary_btn"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp"
    android:layout_marginBottom="10dp">

    <!-- Format Icon Badge -->
    <ImageView
        android:id="@+id/ivItemIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_glass_circle_btn"
        android:padding="9dp"
        android:src="@drawable/ic_qr_code"
        app:tint="@color/apple_blue" />

    <!-- Item Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvItemFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR Code"
                android:textColor="@color/apple_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • Oggi, 14:30"
                android:textColor="@color/ios_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvItemContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://apple.com"
            android:textColor="@color/ios_text_primary"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Copy Action Button -->
    <ImageButton
        android:id="@+id/btnItemCopy"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_glass_circle_btn"
        android:src="@drawable/ic_copy"
        app:tint="@color/ios_text_primary"
        android:layout_marginEnd="6dp"
        android:contentDescription="Copia" />

    <!-- Share Action Button -->
    <ImageButton
        android:id="@+id/btnItemShare"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_glass_circle_btn"
        android:src="@drawable/ic_share"
        app:tint="@color/ios_text_primary"
        android:contentDescription="Condividi" />

</LinearLayout>
